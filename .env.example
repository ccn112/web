# ------------------------------------------------------------------
# X Web Platform — environment template
# Copy to .env and fill values. NEVER commit .env.
# ------------------------------------------------------------------

# --- Database (PostgreSQL) ---
# Matches docker-compose service `postgres`.
DATABASE_URL=postgres://xweb:xweb@localhost:5432/xweb

# --- Payload ---
# Long random string. Generate: openssl rand -base64 32
PAYLOAD_SECRET=change-me-please-generate-a-long-random-secret
# Public URL of the CMS (admin + REST/GraphQL API). In prod = the public CMS domain.
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
# Schema management: unset in dev (auto-push). Set true ONLY for the first prod
# deploy to bootstrap tables, then set false and use `payload migrate`.
# PAYLOAD_DB_PUSH=false

# --- First admin user (created by the seed runner if it does not exist) ---
SEED_ADMIN_EMAIL=admin@x.vn
SEED_ADMIN_PASSWORD=Admin@12345

# --- Media storage (S3 / MinIO) ---
# When true, media uploads go to S3/MinIO. When false, files are stored on the local disk.
USE_S3=false
# When USE_S3=false on a PaaS (Coolify/Railway), the container FS is ephemeral — mount a
# persistent volume and point MEDIA_DIR at it (e.g. /app/media) so uploads survive redeploys.
# Leave unset in dev to use Payload's default local dir.
# MEDIA_DIR=/app/media
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=x-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO needs path-style access
S3_FORCE_PATH_STYLE=true

# --- Frontend (apps/clay public site) ---
# Server-side: clay proxies chat here (may be an internal host in prod).
CMS_URL=http://localhost:3000
# Browser-side: must be the PUBLIC CMS domain (used for next/image media URLs).
NEXT_PUBLIC_CMS_URL=http://localhost:3000
NODE_ENV=development
# Set true only if the CMS is on a private/loopback host without a public domain.
# ALLOW_LOCAL_IMAGE_IP=false

# --- Chat backend (CMS owns the keys; clay never calls the LLM) ---
# Provider: anthropic | openai | gemini | copilot. See docs/CHAT_PROVIDERS.md.
CHAT_PROVIDER=anthropic
# When ANTHROPIC_API_KEY is empty, the widget renders a safe demo state.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Other providers (fill the key to use; pick one via CHAT_PROVIDER)
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# COPILOT_TOKEN=
COPILOT_MODEL=openai/gpt-4o-mini
COPILOT_BASE_URL=https://models.github.ai/inference
# Cost controls
CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_ANON_DAILY_MAX=12
CHAT_REG_DAILY_MAX=60

# --- Outbound mail (SMTP) ---
# Leave MAIL_HOST empty to use Payload's console adapter: nothing leaves the box
# and every message is dumped to the log (that is the way to smoke-test locally).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@x-tech.com.vn
MAIL_FROM_NAME=XTECH
# Staff inbox for lead notifications + the consultant handoff brief.
LEAD_NOTIFY_TO=
# Fallback recipient when LEAD_NOTIFY_TO is unset (used by the dev/test flows).
MAIL_TEST_TO_ADDRESS=

# --- Lead consultation: identity & resume links ---
# See docs/LEAD_CONSULTATION_HANDOFF.md. Everything here has a working default.
# Falls back to PAYLOAD_SECRET when empty.
LEAD_TOKEN_SECRET=
# Root used to build the "tiếp tục hội thoại" links in emails.
LEAD_PUBLIC_SITE_URL=http://localhost:3001
# Resume-token lifetime (336h = 14 days).
LEAD_RESUME_TTL_HOURS=336

# --- Lead consultation: two-way email ---
# Reply-To is built as lead+<conversationPublicId>@<LEAD_REPLY_DOMAIN>. The
# domain's MX / inbound-parse must POST to /api/lead/email-reply.
LEAD_REPLY_DOMAIN=reply.x-tech.com.vn
# REQUIRED in production — the inbound webhook returns 401 without it.
# Dev (NODE_ENV != production) lets requests through so curl works.
LEAD_INBOUND_SECRET=
# Anti-loop budget: automated emails per conversation, and the floor between them.
LEAD_MAX_AUTO_EMAILS=10
LEAD_EMAIL_MIN_INTERVAL_MINUTES=3
LEAD_INBOUND_LIMIT_PER_MINUTE=4

# --- Lead consultation: delayed follow-up (the second touch) ---
# The acknowledgement goes out immediately; this is the wait before the AI comes
# back once on its own with something useful. 0 disables the follow-up entirely.
# Needs the job runner cron below to actually fire.
LEAD_FOLLOWUP_DELAY_MINUTES=30
# A silent lead scoring at/above this goes straight to a consultant instead of
# getting another AI email. Keep it below LEAD_HANDOFF_SCORE.
LEAD_FOLLOWUP_HANDOFF_SCORE=40

# --- Lead consultation: handoff to a human ---
# Score at/above which the brief is good enough for a consultant.
LEAD_HANDOFF_SCORE=62
LEAD_SLA_HOURS=2
# Fallback when no `consultants` record exists; empty falls back to LEAD_NOTIFY_TO.
LEAD_CONSULTANT_TO=
# REQUIRED in production for POST /api/lead/handoff.
LEAD_ADMIN_SECRET=

# --- Lead consultation: AI ---
# Empty = reuse ANTHROPIC_MODEL for the slot-extraction pass (haiku, cheap).
LEAD_ANALYZER_MODEL=
LEAD_RATE_LIMIT_PER_MINUTE=12

# --- Job runner cron ---
# An external scheduler calls GET /api/payload-jobs/run (Payload defines it as
# GET) with `Authorization: Bearer <CRON_SECRET>` — or `?secret=<CRON_SECRET>` —
# every few minutes so due jobs, i.e. the delayed lead follow-up, get processed.
# Without a cron nothing fires the follow-up. No secret = endpoint closed to
# everyone but a logged-in admin.
CRON_SECRET=change-me-cron-secret
